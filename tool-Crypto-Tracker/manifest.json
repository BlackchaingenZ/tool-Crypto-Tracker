{
    "manifest_version": 3,
    "name": "Crypto Tracker Pro",
    "version": "1.0",
    "description": "Build by Ngoc Nguyen, Telegram ngocnguyen2k02",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "host_permissions": [
        "https://api.binance.com/"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "lib/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}